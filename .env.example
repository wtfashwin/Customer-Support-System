# Database (Neon PostgreSQL recommended for production)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_support_system?schema=public"

# Anthropic API
ANTHROPIC_API_KEY="sk-ant-api03-your-key-here"

# Upstash Redis (Optional - for rate limiting)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# API Configuration
API_PORT=3001
NODE_ENV="development"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- AIML ----
# Python FastAPI service at apps/aiml-service. Hono proxies /api/rag/* here.
AIML_SERVICE_URL="http://localhost:8000"

# OpenAI (or Azure OpenAI — set OPENAI_PROVIDER=azure to switch)
OPENAI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBED_MODEL="text-embedding-3-small"

# Azure cognitive services (optional — routes return 503 not_configured if unset)
AZURE_DI_ENDPOINT=""
AZURE_DI_KEY=""
AZURE_SEARCH_ENDPOINT=""
AZURE_SEARCH_KEY=""
AZURE_SEARCH_INDEX="customer-support"

# Auth0 (required for /v1/* JWT verification)
AUTH0_DOMAIN="tenant.us.auth0.com"
AUTH0_AUDIENCE="https://aiml.example.com"

# Redis cache for embedding/chat responses
REDIS_URL="redis://localhost:6379/0"

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=""
LOG_LEVEL="INFO"

# Agentic flow (/v1/agents/run) — see docs/AIML_API_CONTRACT.md §6
AGENT_MAX_ITERATIONS=5
AGENT_DEFAULT_TOP_K=4
